# LLM provider — we'll decide the actual provider in a later step
LLM_PROVIDER=openai
LLM_API_KEY=your_key_here
LLM_MODEL=gpt-4o-mini

# Embeddings (local by default — no API cost)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Vector store
CHROMA_PERSIST_DIR=./chroma_db

# App
APP_ENV=development
